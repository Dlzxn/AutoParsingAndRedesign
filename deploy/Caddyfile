# Reverse proxy с автоматическим HTTPS (Let's Encrypt).
# SITE_DOMAIN — основной домен; REDIRECT_DOMAINS — дополнительные адреса (через запятую), ведущие на основной.

{$SITE_DOMAIN} {
	encode zstd gzip

	# Загрузка видео до MAX_UPLOAD_MB + запас на логотип, музыку и поля формы
	request_body {
		max_size 600MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy app:8000 {
		# Скачивание длинных роликов по ссылке может занимать до нескольких минут
		transport http {
			read_timeout 6m
			write_timeout 6m
		}
	}
}

{$REDIRECT_DOMAINS} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
