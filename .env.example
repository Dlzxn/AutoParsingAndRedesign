# Скопируйте в .env и заполните значения. Файл .env не коммитится.

# --- Общее ---
ENVIRONMENT=production          # development | production
DEBUG=false                     # true — включает /api/docs
LOG_LEVEL=INFO

# --- База данных ---
# Пусто — SQLite в var/app.db (для разработки). В продакшене — PostgreSQL:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autoparsing

# --- Авторизация ---
COOKIE_SECURE=true              # true за HTTPS
AUTH_REQUIRED=true              # поиск/скачивание/редактор только для вошедших
SESSION_TTL_DAYS=30

# --- Ключи платформ ---
YOUTUBE_API_KEY=
IMGUR_CLIENT_ID=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AutoParsing/1.0
TUMBLR_API_KEYS=                # несколько ключей через запятую — резервные
VK_ACCESS_TOKEN=                # пользовательский токен VK; без него поиск VK идёт через Google+Chrome (нестабильно)
MAX_CLIP_DURATION=180           # макс. длительность клипа в выдаче YouTube/VK, сек

# --- Медиа и редактор ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PROXY=                    # например http://user:pass@host:3128
YTDLP_JS_RUNTIMES=deno,node     # для YouTube нужен установленный deno или node
MAX_UPLOAD_MB=500
MAX_SOURCE_DURATION=900         # сек
RENDER_WORKERS=2                # одновременных рендеров (≈ число ядер / 2)
MEDIA_TTL_HOURS=24              # сколько хранить исходники и готовые ролики
